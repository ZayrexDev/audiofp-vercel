# All settings are optional, locally and on Vercel.
# Authentication enabled only for 32+ printable ASCII characters without whitespace.
AUDIOFP_API_KEY=
# Exact DNS hostnames, comma-separated. Invalid entries are ignored.
# No valid entries: any public HTTPS hostname is permitted (SSRF checks still apply).
ALLOWED_AUDIO_HOSTS=
# Rate limiting enabled only when both REST settings are valid.
# Without authentication, all callers share the anonymous rate-limit bucket.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
